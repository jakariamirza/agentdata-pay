# Run locally without a funded wallet. The UI labels these payments as simulated.
PAYMENT_MODE=demo
PORT=3000
BASE_URL=http://localhost:3000

# Required only when PAYMENT_MODE=live.
# Arc Testnet EOA that receives USDC nanopayments.
SELLER_ADDRESS=0x0000000000000000000000000000000000000000

# Arc Testnet EOA private key used by the autonomous buyer.
# Never commit a real private key.
PRIVATE_KEY=0x

# Circle Gateway testnet facilitator.
FACILITATOR_URL=https://gateway-api-testnet.circle.com
